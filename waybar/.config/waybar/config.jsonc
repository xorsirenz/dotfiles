/* -- created by xorsirenz -- */
{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": ["dwl/tags", "dwl/window"],
  "modules-center": [],
  "modules-right": [
    "tray",
    "custom/updates",
    "group/audio",
    "network",
    "custom/vpn",
    "clock",
  ],
  "dwl/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
    "hide-vacant": true,
    "disable-scroll": true,
  },
  "dwl/window": {
    "format": "{layout}",
  },
  "tray": {
    "icon-size": 17,
    "spacing": 8,
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 1800,
    "tooltip": true,
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""],
    },
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%",
    "on-click-middle": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
  },
  "pulseaudio/slider": {
    "tooltip": false,
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"],
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor",
  },
  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn-detect.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
  },
  "clock": {
    "timezone": "America/Los_Angeles",
    "format": "{:%a, %d %b  ·  %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c4a7e7'><b>        {}</b></span>",
        "days": "<span color='#e0def4'> {}</span>",
        "weekdays": "<span color='#908caa'><b> {}</b></span>",
        "today": "<span color='#ebbcba'><b><u> {}</u></b></span>",
      },
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-middle": "shift_reset",
    },
  },
}
